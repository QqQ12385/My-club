# ===== 复制为 .env 后填写（不填则走模拟模式，照样能跑通闭环）=====

# DeepSeek（AI 功能：消息智能分类 / 摘要 / 回复建议）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# 钉钉（企业内部机器人 Webhook，用于种子/降级发送）
DINGTALK_WEBHOOK=             # https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=              # 加签密钥（若机器人开启加签）

# 钉钉企业内部应用（Stream 长连接，双向收发，无需公网回调）
DINGTALK_APP_KEY=             # 企业应用 Client ID（AppKey）
DINGTALK_APP_SECRET=          # 企业应用 Client Secret（AppSecret）

# 钉钉扫码登录（OAuth 授权登录，开放平台单独开通「扫码登录」能力）
DINGTALK_CORP_ID=             # 组织 corpId（开放平台首页「组织信息」里查看）
DINGTALK_LOGIN_REDIRECT=http://localhost:8080/api/auth/dingtalk/callback
                              # 回调地址，需在开放平台「扫码登录」里配置为可信域名/回调

# RPA 通道
RPA_MODE=simulated            # simulated=模拟采集/发送；power_automate=调用本机 Power Automate 流
RPA_FLOW_URL=                 # Power Automate Desktop / 云端流的 HTTP 触发地址

# 服务
HOST=0.0.0.0
PORT=8080
DEMO_ACCOUNT=gary
DEMO_PASSWORD=demo123
